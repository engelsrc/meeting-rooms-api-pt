{
  "info": {
    "_postman_id": "a8e00800-0008-4000-8000-meetingroomsapi",
    "name": "Meeting Rooms API",
    "description": "Postman Collection v2.1 for Meeting Rooms API (RF 008). Happy path + one representative negative per endpoint.\n\nSmoke order: Login OK → Create room → List rooms → Create reservation → Create reservation overlap (409) → List reservations → Cancel → Login bad password → Create room no auth → List rooms bad page → List reservations bad date → Cancel missing id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "roomId", "value": "" },
    { "key": "reservationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('token', json.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login bad password (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Expected HTTP 401"
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "Create room",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id != null) {",
                  "  pm.collectionVariables.set('roomId', String(json.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sala Postman\",\n  \"capacity\": 8,\n  \"location\": \"Piso 1\"\n}"
            },
            "url": "{{baseUrl}}/api/rooms"
          }
        },
        {
          "name": "Create room no auth (403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sala Sin Auth\",\n  \"capacity\": 4,\n  \"location\": \"Piso 2\"\n}"
            },
            "url": "{{baseUrl}}/api/rooms",
            "description": "Expected HTTP 403 — no Authorization header"
          }
        },
        {
          "name": "List rooms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rooms?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List rooms bad page (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rooms?page=-1&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"],
              "query": [
                { "key": "page", "value": "-1" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "Expected HTTP 400"
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Create reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id != null) {",
                  "  pm.collectionVariables.set('reservationId', String(json.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"startAt\": \"2026-12-15T10:00:00-06:00\",\n  \"endAt\": \"2026-12-15T11:00:00-06:00\"\n}"
            },
            "url": "{{baseUrl}}/api/reservations"
          }
        },
        {
          "name": "Create reservation overlap (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"startAt\": \"2026-12-15T10:00:00-06:00\",\n  \"endAt\": \"2026-12-15T11:00:00-06:00\"\n}"
            },
            "url": "{{baseUrl}}/api/reservations",
            "description": "Expected HTTP 409 — same interval as Create reservation while ACTIVE; run before Cancel"
          }
        },
        {
          "name": "List reservations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservations?roomId={{roomId}}&date=2026-12-15&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations"],
              "query": [
                { "key": "roomId", "value": "{{roomId}}" },
                { "key": "date", "value": "2026-12-15" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List reservations bad date (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservations?date=not-a-date&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations"],
              "query": [
                { "key": "date", "value": "not-a-date" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "Expected HTTP 400"
          }
        },
        {
          "name": "Cancel reservation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": {{reservationId}}\n}"
            },
            "url": "{{baseUrl}}/api/reservations/cancel"
          }
        },
        {
          "name": "Cancel reservation missing (404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": 999999\n}"
            },
            "url": "{{baseUrl}}/api/reservations/cancel",
            "description": "Expected HTTP 404"
          }
        }
      ]
    }
  ]
}
